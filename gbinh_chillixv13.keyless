local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local CORRECT_KEY = "ChillixV13GiaBinhBaKhiKey - KsksjwnwkoLkshwowoweho"
local GET_KEY_LINK = "https://link4m.org/MIF7f"
local SCRIPT_URL = "https://raw.githubusercontent.com/nguyengiabinh20111-debug/Gbinh/main/Giabinh.lua"

local KEY_DURATION = 24 * 60 * 60
local SAVE_FILE = "ChilliVenyxDivineV13_SavedKey.json"

local oldGui = CoreGui:FindFirstChild("ChilliVenyxDivineKeySystem")
if oldGui then
	oldGui:Destroy()
end

local function loadMainScript()
	local ok, err = pcall(function()
		loadstring(game:HttpGet(SCRIPT_URL))()
	end)
	if not ok then
		warn("[Chilli X Venyx X Divine V13] Failed to load main script: " .. tostring(err))
	end
end

local function hasFileIO()
	return type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"
end

local function saveVerifiedKey(keyValue)
	if not hasFileIO() then
		return
	end
	pcall(function()
		local payload = HttpService:JSONEncode({
			key = keyValue,
			savedAt = os.time()
		})
		writefile(SAVE_FILE, payload)
	end)
end

local function loadSavedKey()
	if not hasFileIO() then
		return nil
	end
	local ok, data = pcall(function()
		if not isfile(SAVE_FILE) then
			return nil
		end
		local raw = readfile(SAVE_FILE)
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" then
		return nil
	end
	if type(data.key) ~= "string" or type(data.savedAt) ~= "number" then
		return nil
	end
	if data.key ~= CORRECT_KEY then
		return nil
	end
	if (os.time() - data.savedAt) >= KEY_DURATION then
		pcall(function()
			if type(delfile) == "function" and isfile(SAVE_FILE) then
				delfile(SAVE_FILE)
			end
		end)
		return nil
	end
	return data.key
end

local function setClipboardSafe(text)
	if setclipboard then
		setclipboard(text)
		return true
	elseif toclipboard then
		toclipboard(text)
		return true
	end
	return false
end

local function pickFont(candidates, fallback)
	for _, name in ipairs(candidates) do
		local ok, fontEnum = pcall(function()
			return Enum.Font[name]
		end)
		if ok and fontEnum then
			return fontEnum
		end
	end
	return fallback
end

