-- Modern notification update
local function setNotice(kind, text)
	statusLabel.Text = text

	local bgColor = Color3.fromRGB(108, 82, 235)
	local borderColor = Color3.fromRGB(170, 150, 255)
	local textColor = Color3.fromRGB(240, 236, 255)

	if kind == "error" then
		bgColor = Color3.fromRGB(150, 38, 98)
		borderColor = Color3.fromRGB(255, 95, 155)
		textColor = Color3.fromRGB(255, 220, 236)
	elseif kind == "success" then
		bgColor = Color3.fromRGB(45, 125, 230)
		borderColor = Color3.fromRGB(125, 225, 255)
		textColor = Color3.fromRGB(228, 250, 255)
	elseif kind == "info" then
		bgColor = Color3.fromRGB(118, 72, 230)
		borderColor = Color3.fromRGB(200, 135, 255)
		textColor = Color3.fromRGB(245, 236, 255)
	end

	TweenService:Create(
		noticeCard,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = bgColor }
	):Play()

	TweenService:Create(
		noticeStroke,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Color = borderColor }
	):Play()

	statusLabel.TextColor3 = textColor

	noticeCard.Size = UDim2.new(0.84, 0, 0, 46)
	TweenService:Create(
		noticeCard,
		TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.new(0.86, 0, 0, 48) }
	):Play()
end

-- Smooth shake + clear input on invalid key
local isShaking = false
local function triggerError(msg, clearInput)
	if clearInput then
		keyBox.Text = ""
	end

	setNotice("error", "[!] " .. msg)
	warn("[Chilli X Venyx X Divine V13] " .. msg)

	if isShaking then
		return
	end
	isShaking = true

	mainStroke.Color = Color3.fromRGB(255, 95, 155)

	task.spawn(function()
		local offsets = { -8, 7, -5, 4, -2, 1, 0 }
		for _, dx in ipairs(offsets) do
			local tween = TweenService:Create(
				mainFrame,
				TweenInfo.new(0.045, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Position = BASE_POS + UDim2.new(0, dx, 0, 0) }
			)
			tween:Play()
			tween.Completed:Wait()
		end
		mainFrame.Position = BASE_POS
		task.wait(0.25)
		mainStroke.Color = defaultStrokeColor
		isShaking = false
	end)
end

local function unlockAndRun(keyValue)
	saveVerifiedKey(keyValue)
	setNotice("success", "Key verified! Loading Chilli X Venyx X Divine V13...")
	task.wait(0.65)
	screenGui:Destroy()
	loadMainScript()
end

checkBtn.MouseButton1Click:Connect(function()
	local enteredKey = (keyBox.Text or ""):match("^%s*(.-)%s*$") or ""

	if enteredKey == "" then
		triggerError("Please enter a key first.", false)
		return
	end

	if enteredKey == CORRECT_KEY then
		unlockAndRun(enteredKey)
	else
		triggerError("Invalid key! Please check and try again.", true)
	end
end)

getKeyBtn.MouseButton1Click:Connect(function()
	local copied = setClipboardSafe(GET_KEY_LINK)
	if copied then
		setNotice("info", "Get Key link copied to clipboard! Paste it in your browser.")
	else
		setNotice("info", "Get Key Link: " .. GET_KEY_LINK)
	end
end)

-- Auto-unlock if a valid saved key exists within 24 hours
local cachedKey = loadSavedKey()
if cachedKey then
	keyBox.Text = cachedKey
	task.defer(function()
		unlockAndRun(cachedKey)
	end)
end
